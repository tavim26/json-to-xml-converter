%{
#include <stdio.h>
#include <string.h>
#include "proiect.tab.h"    /* token definitions generated by Bison */

/* Current position in the input, used to fill in token locations. */
static int line = 1;
static int column = 1;

/*
 * Flex runs this macro before every rule action.
 * It records where the matched text starts and ends, then advances the column.
 */
#define YY_USER_ACTION                                  \
    yylloc.first_line   = yylloc.last_line = line;      \
    yylloc.first_column = column;                       \
    yylloc.last_column  = column + yyleng - 1;          \
    column += yyleng;
%}

/* noyywrap: single input; nounput/noinput: silence unused-function warnings */
%option noyywrap nounput noinput

%%

"{"             { return LBRACE; }      /* JSON delimiters */
"}"             { return RBRACE; }
"["             { return LBRACKET; }
"]"             { return RBRACKET; }
":"             { return COLON; }
","             { return COMMA; }

\"[^\"\n]*\"    {
                    /* strip the surrounding quotes */
                    yylval.str = strdup(yytext + 1);
                    yylval.str[strlen(yylval.str) - 1] = '\0';
                    return STRING;
                }

\"[^\"\n]*      { return UNTERMINATED; } /* string not closed before end of line */

[0-9]+"."[0-9]+ { yylval.str = strdup(yytext); return STRING; }   /* real numbers */
[0-9]+          { yylval.str = strdup(yytext); return STRING; }   /* integers */

true            { yylval.str = strdup("true");  return STRING; }
false           { yylval.str = strdup("false"); return STRING; }
null            { yylval.str = strdup("null");  return STRING; }

\n              { line++; column = 1; }  /* new line: reset the column */
[ \t\r]+        ;                        /* skip other whitespace */

.               { return INVALID; }      /* anything else is an error */

%%